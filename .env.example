# ───────────────────────────────────────────────────────────────
# Kormo HR — environment. Copy to `.env` and adjust.
# Ports are deliberately non-default to avoid clashing with any
# Postgres/Redis/MinIO already installed on the host machine.
# ───────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database ───────────────────────────────────────────────────
DATABASE_URL="postgresql://kormo:kormo_dev_pw@localhost:55432/kormo_hr?schema=public&connection_limit=20"

# ── Cache / queues ─────────────────────────────────────────────
REDIS_URL="redis://localhost:56379"

# ── Object storage (S3-compatible: MinIO in dev, S3/R2 in prod) ─
S3_ENDPOINT="http://localhost:59000"
S3_REGION="us-east-1"
S3_BUCKET="kormo-media"
S3_ACCESS_KEY="kormo"
S3_SECRET_KEY="kormo_dev_pw"
S3_FORCE_PATH_STYLE=true
# When unset, the API falls back to local-disk storage under apps/api/.storage
STORAGE_DRIVER=s3

# ── Auth ───────────────────────────────────────────────────────
# CHANGE THESE IN PRODUCTION. 32+ random bytes each.
JWT_ACCESS_SECRET="dev-access-secret-change-me-0123456789abcdef"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-fedcba9876543210"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE=false

# ── API ────────────────────────────────────────────────────────
API_PORT=4000
API_PREFIX=api
# Same-origin in dev via the Next.js rewrite; list extra origins here.
CORS_ORIGINS="http://localhost:3000"
THROTTLE_TTL=60
THROTTLE_LIMIT=300

# ── Web ────────────────────────────────────────────────────────
WEB_PORT=3000
# Server-side base URL the Next.js rewrite proxies to.
API_INTERNAL_URL="http://localhost:4000"
# Browser-visible API base — same origin, proxied. Do NOT point this at :4000.
NEXT_PUBLIC_API_BASE_URL="/api"
NEXT_PUBLIC_APP_NAME="Kormo HR"

# ── Seed ───────────────────────────────────────────────────────
# Every demo account is created with this password.
SEED_DEFAULT_PASSWORD="Kormo@123"
SEED_EMPLOYEE_COUNT=64

# Demo tenant identity. Rename freely — nothing in the code hardcodes it.
# The mail domain uses the reserved `.example` TLD, so a seeded address can
# never reach a real inbox.
SEED_COMPANY_NAME="Shurjo Pharma Ltd"
SEED_COMPANY_ALIAS="shurjo"
SEED_COMPANY_DOMAIN="shurjo.example"
SEED_SECOND_COMPANY_NAME="Shurjo Logistics Ltd"
SEED_SECOND_COMPANY_ALIAS="shurjo-logistics"
# Prefix for the HR-facing unique tag on each employee record (SPL-101, …).
SEED_COMPANY_TAG_PREFIX="SPL"
